{
    "name": "your-company/wc-multicurrency-switcher",
    "description": "WooCommerce Multi-Currency Switcher plugin",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4"
    },
    "autoload": {
        "psr-4": {
            "WCMCS\\Core\\": "includes/Core/",
            "WCMCS\\Services\\": "includes/Services/",
            "WCMCS\\Admin\\": "admin/",
            "WCMCS\\Frontend\\": "public/",
            "WCMCS\\Cli\\": "includes/Cli/",
            "WCMCS\\Api\\": "includes/Api/",
            "WCMCS\\Compat\\": "includes/Compat/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WCMCS\\Tests\\Unit\\": "tests/Unit/",
            "WCMCS\\Tests\\Integration\\": "tests/Integration/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9",
        "squizlabs/php_codesniffer": "^3.7",
        "wp-coding-standards/wpcs": "^3.0",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2"
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text",
        "test:integration": "phpunit -c phpunit.integration.xml.dist"
    }
}
