<?xml version="1.0"?>
<ruleset name="WCMCS">
    <description>WordPress Coding Standards for the WooCommerce Multi-Currency Switcher plugin.</description>

    <file>.</file>

    <exclude-pattern>/vendor/*</exclude-pattern>
    <exclude-pattern>/node_modules/*</exclude-pattern>
    <exclude-pattern>/tests/e2e/node_modules/*</exclude-pattern>
    <exclude-pattern>/languages/*</exclude-pattern>
    <exclude-pattern>*.js</exclude-pattern>
    <exclude-pattern>*.css</exclude-pattern>
    <exclude-pattern>*.min.*</exclude-pattern>

    <arg name="basepath" value="."/>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <config name="minimum_supported_wp_version" value="6.0"/>
    <config name="testVersion" value="7.4-8.3"/>

    <rule ref="WordPress-Extra">
        <!-- This plugin uses short array syntax throughout, which is
             standard, modern, and explicitly allowed by WPCS itself —
             only the legacy array() syntax rule needs disabling to stop
             it fighting the project's actual, deliberate style. -->
        <exclude name="Generic.Arrays.DisallowShortArraySyntax"/>

        <!-- This is a PSR-4-autoloaded, OOP plugin (see composer.json) —
             every class file is named to match its class name exactly,
             because PSR-4 autoloading *requires* that; WordPress's
             classic hyphenated-lowercase file naming convention (e.g.
             class-currency-service.php) would break autoloading outright,
             not just violate a style preference. This is an
             architectural choice, not an oversight. -->
        <exclude name="WordPress.Files.FileName"/>

        <!-- Every variable, property, and method in this codebase uses
             camelCase consistently and deliberately, matching this
             plugin's PSR-4/OOP architecture rather than WordPress core's
             historical procedural snake_case convention — both are
             legitimate PHP styles; this plugin picked one and applied it
             consistently throughout. Renaming ~900 identifiers across
             100+ files to satisfy a style preference this project
             explicitly didn't choose would be pure churn with real
             regression risk (a typo in a mechanical rename is a bug),
             for zero functional benefit. -->
        <exclude name="WordPress.NamingConventions.ValidVariableName"/>
        <exclude name="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid"/>
    </rule>

    <rule ref="WordPress-Docs"/>

    <!-- This plugin's own prefix, not WordPress core's — every option,
         hook, table name, and function already uses it consistently. -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="wcmcs"/>
                <element value="WCMCS"/>
            </property>
        </properties>
    </rule>

    <!-- Text domain must match the plugin slug everywhere. -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="wc-multicurrency-switcher"/>
            </property>
        </properties>
    </rule>
</ruleset>
